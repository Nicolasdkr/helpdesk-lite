# Copia este archivo como .env y ajusta los valores.
NODE_ENV=development
PORT=3000

# Base de datos levantada con `docker compose up -d db`
DATABASE_URL="postgresql://helpdesk:helpdesk@localhost:5432/helpdesk?schema=public"

# Orígenes permitidos para CORS (separados por comas)
CORS_ORIGIN=http://localhost:5173

# Clave para firmar los JWT (mínimo 32 caracteres). En producción usa una aleatoria:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria-en-produccion
JWT_EXPIRES_IN=1d
