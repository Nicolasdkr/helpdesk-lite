{
  "info": {
    "name": "Helpdesk Lite API",
    "description": "Colección para probar la API de Helpdesk Lite.\n\n1. Arranca la API (`npm run dev`) y crea los datos demo (`npm run db:seed`).\n2. Ejecuta los tres logins de la carpeta **Auth**: cada uno guarda su token automáticamente.\n3. Prueba el resto de peticiones en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "userToken", "value": "" },
    { "key": "agentToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "ticketId", "value": "" },
    { "key": "assigneeId", "value": "" },
    { "key": "commentId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Estado del servicio",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        },
        {
          "name": "Estado de la base de datos",
          "request": { "method": "GET", "url": "{{baseUrl}}/health/ready" }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login USER",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('userToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@helpdesk.dev\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login AGENT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('agentToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"agent@helpdesk.dev\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@helpdesk.dev\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Registro",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Persona de Prueba\",\n  \"email\": \"prueba@helpdesk.dev\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Mi perfil",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Tickets",
      "item": [
        {
          "name": "Crear ticket (USER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('ticketId', pm.response.json().ticket.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Outlook no sincroniza el calendario\",\n  \"description\": \"Desde esta mañana las reuniones nuevas no aparecen en el calendario de Outlook.\",\n  \"category\": \"SOFTWARE\"\n}"
            },
            "url": "{{baseUrl}}/tickets"
          }
        },
        {
          "name": "Mis tickets (USER)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/tickets"
          }
        },
        {
          "name": "Listar con filtros (AGENT)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{agentToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/tickets?status=OPEN&sort=priority&order=desc&page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["tickets"],
              "query": [
                { "key": "status", "value": "OPEN", "description": "OPEN | IN_PROGRESS | RESOLVED | CLOSED" },
                { "key": "priority", "value": "HIGH", "description": "LOW | MEDIUM | HIGH | URGENT", "disabled": true },
                { "key": "category", "value": "NETWORK", "description": "HARDWARE | SOFTWARE | NETWORK | ACCESS | OTHER", "disabled": true },
                { "key": "assignedToId", "value": "me", "description": "UUID de un técnico o 'me'", "disabled": true },
                { "key": "search", "value": "vpn", "description": "Busca en título y descripción", "disabled": true },
                { "key": "sort", "value": "priority", "description": "createdAt | updatedAt | priority" },
                { "key": "order", "value": "desc", "description": "asc | desc" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "10", "description": "Máximo 50" }
              ]
            }
          }
        },
        {
          "name": "Detalle del ticket",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/tickets/{{ticketId}}"
          }
        },
        {
          "name": "Editar texto (creador)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Las reuniones nuevas no aparecen. Ya probé a reiniciar Outlook.\"\n}"
            },
            "url": "{{baseUrl}}/tickets/{{ticketId}}"
          }
        },
        {
          "name": "Cambiar prioridad (AGENT)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{agentToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"priority\": \"HIGH\"\n}" },
            "url": "{{baseUrl}}/tickets/{{ticketId}}"
          }
        },
        {
          "name": "Técnicos disponibles",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const agent = pm.response.json().users.find((u) => u.role === 'AGENT');",
                  "if (agent) pm.collectionVariables.set('assigneeId', agent.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{agentToken}}" }],
            "url": "{{baseUrl}}/users/agents"
          }
        },
        {
          "name": "Asignar ticket",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{agentToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"assignedToId\": \"{{assigneeId}}\"\n}" },
            "url": "{{baseUrl}}/tickets/{{ticketId}}/assign"
          }
        },
        {
          "name": "Cambiar estado",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{agentToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"RESOLVED\"\n}"
            },
            "url": "{{baseUrl}}/tickets/{{ticketId}}/status",
            "description": "Transiciones válidas: OPEN → IN_PROGRESS/RESOLVED/CLOSED · IN_PROGRESS → OPEN/RESOLVED/CLOSED · RESOLVED → IN_PROGRESS/CLOSED · CLOSED es final."
          }
        },
        {
          "name": "Eliminar ticket (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/tickets/{{ticketId}}"
          }
        }
      ]
    },
    {
      "name": "Comments",
      "description": "Usa el ticket guardado en {{ticketId}}: ejecuta antes 'Crear ticket (USER)'.",
      "item": [
        {
          "name": "Comentar (USER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('commentId', pm.response.json().comment.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"¿Hay alguna novedad? Necesito el calendario para mañana.\"\n}"
            },
            "url": "{{baseUrl}}/tickets/{{ticketId}}/comments"
          }
        },
        {
          "name": "Nota interna (AGENT)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{agentToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Parece un problema del perfil de Outlook. Probar a recrearlo.\",\n  \"isInternal\": true\n}"
            },
            "url": "{{baseUrl}}/tickets/{{ticketId}}/comments"
          }
        },
        {
          "name": "Ver comentarios (USER, sin notas internas)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/tickets/{{ticketId}}/comments"
          }
        },
        {
          "name": "Ver comentarios (AGENT, todos)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{agentToken}}" }],
            "url": "{{baseUrl}}/tickets/{{ticketId}}/comments"
          }
        },
        {
          "name": "Borrar mi comentario (USER)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/tickets/{{ticketId}}/comments/{{commentId}}"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Listar usuarios (ADMIN)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/users"
          }
        }
      ]
    }
  ]
}
